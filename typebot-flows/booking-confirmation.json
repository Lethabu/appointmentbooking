{
  "id": "booking-confirmation",
  "name": "Booking Confirmation Flow",
  "version": "6",
  "groups": [
    {
      "id": "start",
      "title": "Start",
      "blocks": [
        {
          "id": "welcome",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "🎉 Booking Confirmed! Hi {{customerName}}, your appointment for {{serviceName}} has been confirmed."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "whatsapp-notification",
      "title": "WhatsApp Notification",
      "blocks": [
        {
          "id": "send-whatsapp",
          "type": "webhook",
          "options": {
            "url": "{{aiSensyApiUrl}}/send-message",
            "method": "POST",
            "headers": [
              {
                "key": "Authorization",
                "value": "Bearer {{aiSensyApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": "{\n  \"to\": \"{{customerPhone}}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🎉 Booking Confirmed!\\n\\nHi {{customerName}},\\n\\nYour appointment for {{serviceName}} has been confirmed.\\n\\nAppointment ID: {{appointmentId}}\\n\\nWe look forward to seeing you!\\n\\n- {{tenantName}}\"\n  }\n}"
          }
        }
      ]
    }
  ],
  "variables": [
    {
      "id": "customerName",
      "name": "customerName"
    },
    {
      "id": "customerPhone", 
      "name": "customerPhone"
    },
    {
      "id": "serviceName",
      "name": "serviceName"
    },
    {
      "id": "tenantId",
      "name": "tenantId"
    },
    {
      "id": "appointmentId",
      "name": "appointmentId"
    }
  ]
}