{
  "id": "instyle-booking-flow",
  "name": "InStyle Hair Boutique Booking",
  "version": "6",
  "groups": [
    {
      "id": "welcome",
      "title": "Welcome",
      "blocks": [
        {
          "id": "welcome-msg",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Welcome to InStyle Hair Boutique 💇‍♀️\n\nChoose an option:"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "main-menu",
          "type": "choice",
          "items": [
            {
              "id": "book",
              "content": "Book Appointment 🗓️"
            },
            {
              "id": "prices",
              "content": "View Prices 💰"
            },
            {
              "id": "human",
              "content": "Talk to Human 👩‍💼"
            }
          ]
        }
      ]
    },
    {
      "id": "booking",
      "title": "Booking Flow",
      "blocks": [
        {
          "id": "service-choice",
          "type": "choice",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "What service would you like?"
                  }
                ]
              }
            ]
          },
          "items": [
            {
              "id": "wash-cut",
              "content": "Wash & Cut - R350"
            },
            {
              "id": "balayage",
              "content": "Balayage - R650"
            },
            {
              "id": "treatment",
              "content": "Hair Treatment - R450"
            }
          ]
        },
        {
          "id": "date-input",
          "type": "date",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Pick your preferred date:"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "name-input",
          "type": "text input",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "What's your name?"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "phone-input",
          "type": "phone number",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Your WhatsApp number:"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "payment-webhook",
          "type": "webhook",
          "options": {
            "url": "{{webhookUrl}}/api/payments/paystack/create",
            "method": "POST",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": "{\n  \"amount\": {{price}},\n  \"email\": \"{{customerName}}@temp.com\",\n  \"reference\": \"{{service}}-{{date}}\",\n  \"callback_url\": \"{{webhookUrl}}/booking-success\"\n}"
          }
        },
        {
          "id": "payment-link",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Perfect! Complete your booking by paying here:\n\n{{paymentUrl}}\n\nSee you on {{date}} at 14:00! 🕐"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "ai-chat",
      "title": "AI Assistant",
      "blocks": [
        {
          "id": "ai-webhook",
          "type": "webhook",
          "options": {
            "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent",
            "method": "POST",
            "headers": [
              {
                "key": "Authorization",
                "value": "Bearer {{geminiApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": "{\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"You are InStyle Hair Boutique's AI assistant. Answer this question about hair services: {{userQuestion}}\"\n    }]\n  }]\n}"
          }
        },
        {
          "id": "ai-response",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "{{aiResponse}}"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "variables": [
    {
      "id": "customerName",
      "name": "customerName"
    },
    {
      "id": "customerPhone",
      "name": "customerPhone"
    },
    {
      "id": "service",
      "name": "service"
    },
    {
      "id": "date",
      "name": "date"
    },
    {
      "id": "price",
      "name": "price"
    },
    {
      "id": "webhookUrl",
      "name": "webhookUrl",
      "defaultValue": "https://your-platform-domain.com"
    },
    {
      "id": "geminiApiKey",
      "name": "geminiApiKey"
    }
  ],
  "edges": [
    {
      "from": {
        "groupId": "welcome",
        "blockId": "main-menu"
      },
      "to": {
        "groupId": "booking"
      }
    }
  ]
}