{
  "version": 2,

  "routes": [
    {
      "src": "/instyle",
      "dest": "/instyle"
    },
    {
      "src": "/dashboard/instyle",
      "dest": "/dashboard/instyle"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],


  "functions": {
    "app/api/*/route.js": {
      "maxDuration": 30
    }
  }
}