{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://instylehairboutique.appointmentbooking.co.za/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "instylehairboutique.co.za"
        }
      ]
    }
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}