{
  "version": 2,
  "rewrites": [
    {
      "source": "/book",
      "destination": "/[...catchall]",
      "has": [{ "type": "host", "value": "www.instylehairboutique.co.za" }]
    },
    {
      "source": "/booking",
      "destination": "/[...catchall]",
      "has": [{ "type": "host", "value": "www.instylehairboutique.co.za" }]
    },
    {
      "source": "/",
      "destination": "/[...catchall]",
      "has": [{ "type": "host", "value": "www.instylehairboutique.co.za" }]
    },
    {
      "source": "/(.*)",
      "destination": "/[...catchall]",
      "has": [{ "type": "host", "value": "www.instylehairboutique.co.za" }]
    },
    {
      "source": "/(.*)",
      "destination": "/emergency/index.html",
      "has": [{ "type": "host", "value": "appointmentbooking.co.za" }]
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Emergency-Mode", "value": "active" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}