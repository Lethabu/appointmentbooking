{
  "compilerOptions": {
    "lib": ["DOM","DOM.Iterable","ES2022"],
    "allowJs": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "convex/*": ["convex/*"]
    }
  },
  "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        "convex/**/*.ts",
        "convex/_generated/**/*.d.ts",
        "convex/_generated/**/*.ts"
      ],
  "exclude": ["node_modules", "Claude code", "Fix", "apps/web"]
}