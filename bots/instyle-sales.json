{
  "name": "InStyle Sales Bot",
  "description": "AI-powered sales assistant for InStyle Hair Boutique",
  "variables": {
    "tenantId": "instylehairboutique",
    "salonName": "InStyle Hair Boutique",
    "currency": "ZAR"
  },
  "blocks": [
    {
      "id": "welcome",
      "type": "text",
      "content": "Hi! I'm Nia, your InStyle Hair Boutique assistant 💇‍♀️\n\nHow can I help you today?"
    },
    {
      "id": "main_menu",
      "type": "button",
      "content": "What would you like to do?",
      "buttons": [
        { "label": "🛍️ Shop Products", "value": "shop" },
        { "label": "📅 Book Service", "value": "book" },
        { "label": "💬 Chat with Human", "value": "human" },
        { "label": "ℹ️ Salon Info", "value": "info" }
      ]
    },
    {
      "id": "shop_menu",
      "type": "button",
      "content": "Browse our premium products:",
      "buttons": [
        { "label": "Hair Treatments", "value": "treatments" },
        { "label": "Extensions", "value": "extensions" },
        { "label": "Styling Products", "value": "styling" },
        { "label": "View All", "value": "all_products" }
      ]
    },
    {
      "id": "service_menu",
      "type": "button",
      "content": "Which service interests you?",
      "buttons": [
        { "label": "Middle & Side Installation - R450", "value": "middle_side" },
        { "label": "Maphondo & Lines - R600", "value": "maphondo" },
        { "label": "Hair Treatment - R250", "value": "treatment" }
      ]
    },
    {
      "id": "date_picker",
      "type": "date_picker",
      "content": "Perfect! When would you like to book your {{service}}?",
      "variable": "booking_date"
    },
    {
      "id": "booking_webhook",
      "type": "webhook",
      "url": "https://instylehairboutique.co.za/api/book",
      "method": "POST",
      "body": {
        "tenantId": "{{tenantId}}",
        "service": "{{service}}",
        "date": "{{booking_date}}",
        "client_phone": "{{phone}}",
        "source": "whatsapp_bot"
      }
    },
    {
      "id": "ai_response",
      "type": "webhook",
      "url": "https://api.openai.com/v1/chat/completions",
      "headers": {
        "Authorization": "Bearer {{OPENAI_API_KEY}}",
        "Content-Type": "application/json"
      },
      "body": {
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "system",
            "content": "You are Nia, a friendly hair stylist assistant for InStyle Hair Boutique in South Africa. Help customers with bookings, product recommendations, and salon information. Always mention prices in ZAR (South African Rand). Services: Middle & Side Installation (R450, 60min), Maphondo & Lines (R600, 90min), Hair Treatment (R250, 30min)."
          },
          {
            "role": "user",
            "content": "{{userMessage}}"
          }
        ]
      }
    },
    {
      "id": "salon_info",
      "type": "text",
      "content": "📍 InStyle Hair Boutique\n\n🕒 Operating Hours:\nMon-Fri: 9AM - 6PM\nSat: 8AM - 4PM\nSun: Closed\n\n📱 Follow us:\nInstagram: @instyle_hair_boutique_\nTikTok: @instylehairboutique\n\n🌐 Website: instylehairboutique.co.za"
    }
  ],
  "flows": [
    {
      "trigger": "welcome",
      "next": "main_menu"
    },
    {
      "trigger": "shop",
      "next": "shop_menu"
    },
    {
      "trigger": "book",
      "next": "service_menu"
    },
    {
      "trigger": "info",
      "next": "salon_info"
    },
    {
      "trigger": "human",
      "next": "ai_response"
    }
  ]
}