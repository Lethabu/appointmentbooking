# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Paystack Configuration
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# Production URLs
NEXT_PUBLIC_SITE_URL=https://appointmentbooking.co.za
NEXT_PUBLIC_INSTYLE_URL=https://instylehairboutique.co.za

# Secrets (managed via Firebase Secret Manager)
# GEMINI_API_KEY=your-gemini-api-key
# PAYSTACK_SECRET_KEY=your-paystack-secret
# WHATSAPP_API_TOKEN=your-whatsapp-token