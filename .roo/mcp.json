{
  "mcpServers": {
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {},
      "alwaysAllow": [
        "API-post-database-query"
      ]
    },
    "whatsapp": {
      "command": "python",
      "args": [
        "main.py"
      ],
      "env": {}
    }
  }
}