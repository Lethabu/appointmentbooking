{
  "input": {
    "file": "./design-tokens.fig",
    "format": "figma"
  },
  "output": {
    "file": "./tokens.json",
    "format": "json"
  },
  "themes": [
    {
      "name": "light",
      "mode": "light"
    },
    {
      "name": "dark",
      "mode": "dark"
    }
  ],
  "transformers": [
    {
      "type": "tokens",
      "options": {
        "includeAliases": true,
        "includeModes": true
      }
    },
    {
      "type": "css",
      "options": {
        "outputFormat": "scss",
        "includeAliases": true,
        "includeModes": true,
        "fileName": "design-tokens",
        "cssCustomProperties": true
      }
    },
    {
      "type": "tailwind",
      "options": {
        "includeAliases": true,
        "includeModes": true
      }
    }
  ]
}
